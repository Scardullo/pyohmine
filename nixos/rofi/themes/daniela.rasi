configuration {
    modi: "drun";
    display-drun: "";
    display-run: "";
    display-window: "";
    show-icons: true;
    icon-theme: "Adwaita";
    font: "Agave Nerd Font Mono 11";
    drun-display-format: "{icon} {name}";
}

* {
    bg:     rgba(24, 24, 37, 0.85);
    bg-alt: rgba(69, 71, 90, 0.75);
    fg:     #CDD6F4;

    selected:#89B4FA;
    active: #A6E3A1;
    urgent: #F38BA8;

    border-col: #89B4FA;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 600px;
    border: 2px;
    border-color: @border-col;
    border-radius: 14px;
    padding: 12px;
    background-color: @bg;
}

inputbar {
    background-color: @bg-alt;
    border: 1.5px;
    border-color: @border-col;
    border-radius: 10px;
    padding: 10px;
    margin: 0 0 12px 0;
}

prompt {
    enabled: false;
}

entry {
    placeholder: "Search...";
}

listview {
    lines: 8;
    spacing: 6px;
}

element {
    padding: 10px;
    border-radius: 10px;
}

element selected.normal {
    background-color: @selected;
    text-color: #181825;
}

element selected.active {
    background-color: @active;
    text-color: #181825;
}

element selected.urgent {
    background-color: @urgent;
    text-color: #181825;
}

element-icon {
    size: 48px;
    margin: 0 12px 0 0;
}
