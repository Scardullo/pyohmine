#!/usr/bin/env bash

# -------------------------
# KILL OLD INSTANCES CLEANLY
# -------------------------
pkill swaybg 2>/dev/null
pkill waybar 2>/dev/null
pkill hypridle 2>/dev/null

sleep 0.5

# -------------------------
# WALLPAPER
# -------------------------
WALL="/home/anthony/Pictures/wallpaper/nord_valley.png"

swaybg -o DP-1 -i "$WALL" -m fill \
       -o HDMI-A-1 -i "$WALL" -m fill &

# -------------------------
# WAYBAR
# -------------------------
mkdir -p ~/.cache/hypr
waybar > ~/.cache/hypr/waybar.log 2>&1 &

# -------------------------
# IDLE DAEMON (screen off after timeout; respects waybar's idle inhibitor)
# -------------------------
hypridle &
