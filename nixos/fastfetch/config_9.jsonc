{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "/home/anthony/Pictures/ft15_nixos.png",
        //"padding": {
	  //"top": 2,
	//}
    },

    "display": {
        "separator": "  ",
        "constants": [
            "─────────────────"
        ],
        "key": {
            "type": "icon",
            "paddingLeft": 2
        }
    },

    "modules": [
        {
            "type": "custom"
        },

        {
            "type": "custom",
            "format": "┌{$1} {#1}Hardware Information{#} {$1}┐"
        },
        "host",
        "cpu",
        "gpu",
        "disk",
        "memory",
        "display",
        "brightness",
        "battery",
        "poweradapter",
        "bluetooth",
        "sound",
        "gamepad",

        {
            "type": "custom",
            "format": "├{$1} {#1}Software Information{#} {$1}┤"
        },

        {
            "type": "title",
            "keyIcon": "",
            "key": "Title",
            "format": "{user-name}@{host-name}"
        },

        "os",
        "kernel",
        "lm",
        "de",
        "wm",
        "shell",
        "terminal",
        "terminalfont",
        "theme",
        "icons",
        "wallpaper",
        "packages",

        {
            "type": "custom",
            "format": "└{$1}──────────────────────{$1}┘"
        },

        {
            "type": "colors",
            "paddingLeft": 22,
            "symbol": "circle"
        }
    ]
}
