#!/usr/bin/env bash
# Switch to the isabel theme: wallpaper, kitty, hyprland, waybar.
set -e

wallpp "/home/anthony/Pictures/wallpaper/daniela.webp"

cp ~/.config/kitty/isabel ~/.config/kitty/kitty.conf
cp ~/Documents/fastfetch-configs/small-nix ~/.config/fastfetch/config.jsonc
cp ~/.config/hypr/isabel.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/isabel_style.css ~/.config/waybar/style.css
pkill waybar; sleep 0.3; waybar >/dev/null 2>&1 &
disown
