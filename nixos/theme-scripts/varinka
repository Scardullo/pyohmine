#!/usr/bin/env bash
# Switch to the varinka theme: wallpaper, kitty, hyprland, waybar.
set -e

wallpp "/home/anthony/Pictures/wallpaper/gh0stzk/varinka/wall-01.webp"

cp ~/.config/kitty/varinka ~/.config/kitty/kitty.conf
cp /home/anthony/pyohmine/nixos/fastfetch/config_7.jsonc ~/.config/fastfetch/config.jsonc
cp /home/anthony/pyohmine/nixos/zshrc/p10k ~/.zshrc
cp ~/.config/hypr/varinka.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/varinka_style.css ~/.config/waybar/style.css
pkill waybar; sleep 0.3; waybar >/dev/null 2>&1 &
disown
