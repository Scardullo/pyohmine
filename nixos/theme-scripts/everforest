#!/usr/bin/env bash
# Switch to the everforest theme: wallpaper, kitty, hyprland, waybar.
set -e

wallpp "/home/anthony/Pictures/wallpaper/fog_forest_1.png"

cp ~/.config/kitty/everforest ~/.config/kitty/kitty.conf
cp /home/anthony/pyohmine/nixos/fastfetch/config_7.jsonc ~/.config/fastfetch/config.jsonc
cp /home/anthony/pyohmine/nixos/zshrc/p10k ~/.zshrc
cp ~/.config/hypr/everforest.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/everforest_style.css ~/.config/waybar/style.css
pkill waybar; sleep 0.3; waybar >/dev/null 2>&1 &
disown
