#!/usr/bin/env bash
# Switch to the z0mbi3 theme: wallpaper, kitty, hyprland, waybar.
set -e

wallpp "/home/anthony/Pictures/wallpaper/karla.webp"

cp ~/.config/kitty/z0mbi3 ~/.config/kitty/kitty.conf
cp ~/Documents/fastfetch-configs/small-nix ~/.config/fastfetch/config.jsonc
cp ~/.config/hypr/z0mbi3.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/z0mbi3_style.css ~/.config/waybar/style.css
pkill waybar; sleep 0.3; waybar >/dev/null 2>&1 &
disown
