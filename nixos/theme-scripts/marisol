#!/usr/bin/env bash
# Switch to the marisol theme: wallpaper, kitty, hyprland, waybar.
set -e

wallpp "/home/anthony/Pictures/wallpaper/gh0stzk/marisol/wall-04.webp"

cp ~/.config/kitty/marisol ~/.config/kitty/kitty.conf
cp /home/anthony/pyohmine/nixos/fastfetch/config_7.jsonc ~/.config/fastfetch/config.jsonc
cp ~/.config/hypr/marisol.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/marisol_style.css ~/.config/waybar/style.css
pkill waybar; sleep 0.3; waybar >/dev/null 2>&1 &
disown
