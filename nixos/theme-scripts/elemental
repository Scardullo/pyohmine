#!/usr/bin/env bash
# Switch to the elemental theme: wallpaper, kitty, hyprland, waybar.
set -e

wallpp "/home/anthony/Pictures/wallpaper/boy-cat.webp"

cp ~/.config/kitty/elemental ~/.config/kitty/kitty.conf

cp ~/.config/hypr/elemental.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/elemental_style.css ~/.config/waybar/style.css
pkill waybar; sleep 0.3; waybar >/dev/null 2>&1 &
disown
