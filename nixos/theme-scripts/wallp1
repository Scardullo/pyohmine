#!/usr/bin/env bash
# Set wallpaper on DP-1 only and remember it for next login.

if [ -z "$1" ]; then
    echo "Usage: wallp1 /path/to/wallpaper"
    exit 1
fi

WALL="$1"
OUTPUT="DP-1"
WALL_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"
mkdir -p "$WALL_STATE"

pkill -f "swaybg -o $OUTPUT "
sleep 0.2

swaybg -o "$OUTPUT" -i "$WALL" -m fill &
echo "$WALL" > "$WALL_STATE/$OUTPUT"
