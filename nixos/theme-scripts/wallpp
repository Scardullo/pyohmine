#!/usr/bin/env bash
# Set wallpaper on BOTH monitors (DP-1 + HDMI-A-2) and remember it for next login.

if [ -z "$1" ]; then
    echo "Usage: wallpp /path/to/wallpaper"
    exit 1
fi

WALL="$1"
WALL_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"
mkdir -p "$WALL_STATE"

pkill swaybg
sleep 0.2

for mon in DP-1 HDMI-A-2; do
    swaybg -o "$mon" -i "$WALL" -m fill &
    echo "$WALL" > "$WALL_STATE/$mon"
done
