{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 6,

    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
	"custom/media"
    ],

    "modules-center": [
        "custom/hypridle",
        "clock"
    ],

    "modules-right": [
        "custom/weather",
        "pulseaudio",
        "network",
        "cpu",
        "memory"
    ],

    "custom/logo": {
        "format": "",
        "tooltip": false
    },

//    "custom/media": {
//        "exec": "/home/anthony/.config/waybar/scripts/mediainfo.sh",
//        "return-type": "text",
//        "interval": 2
//    },

    "custom/hypridle": {
        "exec": "/home/anthony/.config/waybar/scripts/hypridle-toggle.sh",
        "on-click": "/home/anthony/.config/waybar/scripts/hypridle-toggle.sh --toggle",
        "return-type": "json",
        "interval": 2
    },

    "clock": {
        "format": "{:%I:%M %p}"
    },

    "custom/weather": {
        "exec": "/home/anthony/.config/waybar/scripts/weather.sh",
        "interval": 600,
        "format": " {}",
        "tooltip": false
    },

    "cpu": {
        "format": "󰍛 {usage}%"
    },

    "memory": {
        "format": " {percentage}%"
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ifname}",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        }
    }
}
