configuration {
    modi: "dmenu";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 13";
}

* {
    /* The colors come from the panel behind this window (see rofi-name-popup), so everything
       here is see-through or neutral enough to sit on any theme. */
    bg:         transparent;
    bg-alt:     rgba(255, 255, 255, 0.10);
    fg:         #e8e8f0;
    selected:   #b8b8c0;
    border-col: transparent;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 1100px;
    border: 2px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 20px;
    background-color: @bg;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 0px;
    padding: 10px 14px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @selected;
}

entry {
    placeholder: "Search theme:";
    placeholder-color: rgba(230, 230, 240, 0.45);
}

listview {
    columns: 6;
    lines: 4;
    spacing: 14px;
    /* true leaves the last theme's image behind in empty slots while searching */
    fixed-height: false;
    fixed-columns: true;
    scrollbar: false;
}

element {
    children: [ element-icon ];
    padding: 10px;
    border-radius: 0px;
    border: 2px;
    border-color: transparent;
}

element-icon {
    size: 150px;
    border-radius: 0px;
    horizontal-align: 0.5;
}

element selected.normal {
    background-color: @bg-alt;
    border-color: @selected;
}
