configuration {
    modi: "drun";
    display-drun: "";
    display-run: "";
    display-window: "";
    show-icons: true;
    icon-theme: "Gruvbox-Plus-Dark";
    font: "Agave Nerd Font Mono 11";
    drun-display-format: "{icon} {name}";
}

* {
    bg:     rgba(45, 53, 59, 0.85);
    bg-alt: rgba(58, 66, 72, 0.75);
    fg:     #d3c6aa;

    selected:#d3c6aa;
    active: #83c092;
    urgent: #e67e80;

    border-col: #d3c6aa;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 800px;
    border: 2px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 12px;
    background-color: @bg;
}

inputbar {
    background-color: @bg-alt;
    border: 1.5px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 10px;
    margin: 0 0 12px 0;
}

prompt {
    enabled: false;
}

entry {
    placeholder: "Search...";
}

listview {
    lines: 8;
    spacing: 6px;
}

element {
    padding: 10px;
    border: 1.5px;
    border-color: transparent;
    border-radius: 0px;
}

element-text {
    text-color: inherit;
}

element selected.normal {
    background-color: transparent;
    border-color: @selected;
    text-color: @selected;
}

element selected.active {
    background-color: transparent;
    border-color: @active;
    text-color: @active;
}

element selected.urgent {
    background-color: transparent;
    border-color: @urgent;
    text-color: @urgent;
}

element-icon {
    size: 27px;
    margin: 0 12px 0 0;
}
