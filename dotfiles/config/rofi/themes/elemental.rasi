configuration {
    modi: "drun";
    display-drun: "";
    display-run: "";
    display-window: "";
    show-icons: true;
    icon-theme: "Gruvbox-Plus-Dark";
    font: "Agave Nerd Font Mono 11";
    drun-display-format: "{icon} {name}";
}

* {
    bg:     rgba(74, 42, 18, 0.92);   /* #4a2a12 */
    bg-alt: rgba(58, 33, 14, 0.90);   /* #3a210e */
    fg:     #ebdbb2;

    selected: #6b3a14;
    active:   #7a4218;
    urgent:   #e67e80;

    border-col: #ebdbb2;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 800px;
    border: 2px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 12px;
    background-color: rgba(33, 17, 5, 0.90);   /* #211105 @ 0.9, matches hyprland active/inactive_opacity */
}

inputbar {
    background-color: @bg-alt;
    border: 1.5px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 10px;
    margin: 0 0 12px 0;
}

prompt {
    enabled: false;
}

entry {
    placeholder: "Search...";
}

listview {
    lines: 8;
    spacing: 6px;
}

element {
    padding: 10px;
    border-radius: 0px;
}

element selected.normal {
    background-color: @selected;
    text-color: #ebdbb2;
}

element selected.active {
    background-color: @active;
    text-color: #ebdbb2;
}

element selected.urgent {
    background-color: @urgent;
    text-color: #ebdbb2;
}

element-icon {
    size: 27px;
    margin: 0 12px 0 0;
}
