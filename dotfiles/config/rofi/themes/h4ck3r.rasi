configuration {
    modi: "drun";
    display-drun: "";
    display-run: "";
    display-window: "";
    show-icons: true;
    icon-theme: "Gruvbox-Plus-Dark";
    font: "Agave Nerd Font Mono 11";
    drun-display-format: "{icon} {name}";
}

* {
    bg:     rgba(12, 16, 24, 0.85);
    bg-alt: rgba(27, 35, 51, 0.75);
    fg:     #1947e0;

    selected:#76EA00;
    active: #00fa5c;
    urgent: #6DDE00;

    border-col: #76EA00;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 600px;
    border: 2px;
    border-color: @border-col;
    border-radius: 14px;
    padding: 12px;
    background-color: @bg;
}

inputbar {
    background-color: @bg-alt;
    border: 1.5px;
    border-color: @border-col;
    border-radius: 10px;
    padding: 10px;
    margin: 0 0 12px 0;
}

prompt {
    enabled: false;
}

entry {
    placeholder: "Search...";
}

listview {
    lines: 8;
    spacing: 6px;
}

element {
    padding: 10px;
    border-radius: 10px;
}

element selected.normal {
    background-color: @selected;
    text-color: #0c1018;
}

element selected.active {
    background-color: @active;
    text-color: #0c1018;
}

element selected.urgent {
    background-color: @urgent;
    text-color: #0c1018;
}

element-icon {
    size: 48px;
    margin: 0 12px 0 0;
}
