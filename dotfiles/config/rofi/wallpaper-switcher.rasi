configuration {
    modi: "dmenu";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 13";
}

* {
    bg:         rgba(13, 15, 24, 0.95);
    bg-alt:     rgba(134, 170, 236, 0.16);
    fg:         #a5b6cf;
    selected:   #86aaec;
    border-col: #86aaec;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 900px;
    border: 2px;
    border-color: @border-col;
    border-radius: 18px;
    padding: 20px;
    background-color: @bg;
}

mainbox {
    children: [ listview ];
}

listview {
    columns: 4;
    lines: 5;
    spacing: 12px;
    fixed-height: true;
    fixed-columns: true;
    scrollbar: false;
}

element {
    children: [ element-icon ];
    padding: 6px;
    border-radius: 12px;
    border: 2px;
    border-color: transparent;
}

element-icon {
    size: 200px;
    border-radius: 8px;
    horizontal-align: 0.5;
}

element selected.normal {
    background-color: @bg-alt;
    border-color: @selected;
}
