configuration {
    modi: "dmenu";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 13";
}

* {
    bg:         rgba(24, 22, 22, 0.95);
    bg-alt:     rgba(127, 180, 202, 0.16);
    fg:         #c5c9c5;
    selected:   #7FB4CA;
    border-col: #7FB4CA;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 900px;
    border: 2px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 20px;
    background-color: @bg;
}

mainbox {
    children: [ listview ];
}

listview {
    columns: 4;
    lines: 5;
    spacing: 12px;
    fixed-height: true;
    fixed-columns: true;
    scrollbar: false;
}

element {
    children: [ element-icon ];
    padding: 6px;
    border-radius: 0px;
    border: 2px;
    border-color: transparent;
}

element-icon {
    size: 200px;
    border-radius: 0px;
    horizontal-align: 0.5;
}

element selected.normal {
    background-color: @bg-alt;
    border-color: @selected;
}
