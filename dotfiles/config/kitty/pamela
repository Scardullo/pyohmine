# Pamela -- (Lovelace) colorscheme, from gh0stzk's dotfiles
# https://github.com/gh0stzk/dotfiles
# font_family JetBrainsMono Nerd Font
font_size 14.0

confirm_os_window_close 0

# The basic colors
foreground              #FDFDFD
background              #1D1F28
selection_foreground    #1D1F28
selection_background    #79E6F3

# Cursor colors
cursor                  #FDFDFD
cursor_text_color       #1D1F28

# URL underline color when hovering with mouse
url_color               #8897F4

# Kitty window border colors
active_border_color     #C574DD
inactive_border_color   #282A36
bell_border_color       #F2A272

# Tab bar colors
active_tab_foreground   #1D1F28
active_tab_background   #C574DD
inactive_tab_foreground #FDFDFD
inactive_tab_background #282A36
tab_bar_background      #1D1F28

# The 16 terminal colors

# black
color0 #282A36
color8 #414458

# red
color1 #F37F97
color9 #FF4971

# green
color2  #5ADECD
color10 #18E3C8

# yellow
color3  #F2A272
color11 #FF8037

# blue
color4  #8897F4
color12 #556FFF

# magenta
color5  #C574DD
color13 #B043D1

# cyan
color6  #79E6F3
color14 #3FDCEE

# white
color7  #FDFDFD
color15 #BEBEC1

# BEGIN_KITTY_FONTS
font_family      family="Agave Nerd Font Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
