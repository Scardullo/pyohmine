#!/usr/bin/env bash
# Switch to the emilia theme: wallpaper, kitty, hyprland, waybar.
set -e
mkdir -p "$HOME/.local/state"
echo "$(basename "$0")" > "$HOME/.local/state/current-theme"

wallpp "/home/anthony/Pictures/wallpaper/emilia.webp"

cp ~/.config/kitty/emilia ~/.config/kitty/kitty.conf
cp ~/Documents/fastfetch-configs/arch3 ~/.config/fastfetch/config.jsonc
cp ~/pyohmine/dotfiles/zshrc/p10k ~/.zshrc
cp ~/.config/hypr/emilia.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/emilia_style.css ~/.config/waybar/style.css
pkill waybar || true; sleep 0.3; waybar >/dev/null 2>&1 &
disown
