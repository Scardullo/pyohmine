#!/usr/bin/env bash
# Switch to the gruvbox theme: wallpaper, kitty, hyprland, waybar.
set -e
mkdir -p "$HOME/.local/state"
echo "$(basename "$0")" > "$HOME/.local/state/current-theme"

wallp1 "/home/anthony/Pictures/wallpaper/gruvpenguin2.png"
wallp2 "/home/anthony/Pictures/wallpaper/firefox.png"

cp ~/.config/kitty/gruvbox ~/.config/kitty/kitty.conf
cp ~/Documents/fastfetch-configs/arch3 ~/.config/fastfetch/config.jsonc
cp ~/Documents/zshrc/p10k ~/.zshrc
cp ~/.config/hypr/gruvbox.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/gruvbox_style.css ~/.config/waybar/style.css
pkill waybar || true; sleep 0.3; waybar >/dev/null 2>&1 &
disown
