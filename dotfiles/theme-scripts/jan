#!/usr/bin/env bash
# Switch to the jan theme: wallpaper, kitty, hyprland, waybar.
set -e
mkdir -p "$HOME/.local/state"
echo "$(basename "$0")" > "$HOME/.local/state/current-theme"

wallpp "/home/anthony/Pictures/wallpaper/gh0stzk/emilia/wall-11.webp"

cp ~/.config/kitty/jan ~/.config/kitty/kitty.conf
cp ~/Documents/fastfetch-configs/arch3 ~/.config/fastfetch/config.jsonc
cp ~/Documents/zshrc/p10k ~/.zshrc
cp ~/.config/hypr/jan.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/jan_style.css ~/.config/waybar/style.css
pkill waybar || true; sleep 0.3; waybar >/dev/null 2>&1 &
disown
