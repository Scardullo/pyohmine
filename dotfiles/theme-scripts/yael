#!/usr/bin/env bash
# Switch to the yael theme: wallpaper, kitty, hyprland, waybar.
set -e
mkdir -p "$HOME/.local/state"
echo "$(basename "$0")" > "$HOME/.local/state/current-theme"

wallpp "/home/anthony/Pictures/wallpaper/gh0stzk/yael/wall-03.webp"

cp ~/.config/kitty/yael ~/.config/kitty/kitty.conf
cp ~/Documents/fastfetch-configs/arch3 ~/.config/fastfetch/config.jsonc
cp ~/Documents/bash_zsh_rc/myhypr/p10k ~/.zshrc
cp ~/.config/hypr/yael.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/yael_style.css ~/.config/waybar/style.css
pkill waybar || true; sleep 0.3; waybar >/dev/null 2>&1 &
disown
