#!/usr/bin/env bash
# Switch to the archlinux theme: wallpaper, kitty, hyprland, waybar.
set -e
mkdir -p "$HOME/.local/state"
echo "$(basename "$0")" > "$HOME/.local/state/current-theme"

wallpp "/home/anthony/Pictures/wallpaper/wall-03.webp"

cp ~/.config/kitty/archlinux ~/.config/kitty/kitty.conf
cp ~/Documents/fastfetch-configs/anime ~/.config/fastfetch/config.jsonc
cp ~/Documents/zshrc/p10k ~/.zshrc
cp ~/.config/hypr/archlinux.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/archlinux_style.css ~/.config/waybar/style.css
pkill waybar || true; sleep 0.3; waybar >/dev/null 2>&1 &
disown
