#!/usr/bin/env bash
# Pull the live copies of every tracked dotfile back into the repos.
# Reverse of dotfiles/install.sh: for each file already in <repo>/dotfiles, find where
# install.sh puts it and copy it back if the live file differs and is newer.
#
# Usage: sync-dotfiles [-n|--dry-run] [-f|--force] [-a|--add]
#   -n  show what would be copied, change nothing
#   -f  copy even when the repo file is newer than the live one
#   -a  also add new files found in ~/.config/<tracked dir>, ~/Documents/starship, ~/Pictures/wallpaper,
#       ~/Documents/fastfetch-configs and ~/Pictures/fastfetch_pics
set -euo pipefail

REPOS=("$HOME/pyohmine/dotfiles" "$HOME/py_oh_my/dotfiles")
SYSTEM_BIN=" wallpp wallp1 wallp2 "   # installed to /usr/local/bin, the rest to ~/.local/bin
SKIP=" install.sh theme-scripts/claude "

# Theme assets kept beside dotfiles/, in the repo's Documents/ (install.sh places them from there):
# repo path relative to <repo>/dotfiles  ->  live directory
declare -A ASSETS=(
  [../Documents/fastfetch-configs]="$HOME/Documents/fastfetch-configs"
  [../Documents/Pictures/fastfetch_pics]="$HOME/Pictures/fastfetch_pics"
)

dry=0 force=0 add=0
for arg; do
  case $arg in
    -n|--dry-run) dry=1 ;;
    -f|--force)   force=1 ;;
    -a|--add)     add=1 ;;
    -h|--help)    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $arg (try --help)" >&2; exit 1 ;;
  esac
done

# live location of a repo-relative path, or nothing if it has no live counterpart
source_for() {
  local rel=$1 name=${1##*/}
  case $rel in
    # the theme scripts copy starship themes out of ~/Documents/starship
    config/starship/*) echo "$HOME/Documents/starship/$name" ;;
    config/*)        echo "$HOME/.config/${rel#config/}" ;;
    wallpaper/*)      echo "$HOME/Pictures/wallpaper/${rel#wallpaper/}" ;;
    src/*)            echo "$HOME/.local/src/${rel#src/}" ;;
    # not ~/.zshrc: the theme scripts overwrite it with whichever variant is active
    zshrc/*)          echo "$HOME/Documents/zshrc/$name" ;;
    theme-scripts/*)
      if [[ $SYSTEM_BIN == *" $name "* ]]; then echo "/usr/local/bin/$name"
      else echo "$HOME/.local/bin/$name"; fi ;;
    ../*)
      local dir
      for dir in "${!ASSETS[@]}"; do
        [[ $rel == "$dir"/* ]] && { echo "${ASSETS[$dir]}/${rel#"$dir"/}"; return; }
      done ;;
  esac
}

copied=0 kept=0 missing=0

copy() {  # copy SRC DEST LABEL
  printf '  \033[32m%-8s\033[0m %s\n' "$3" "${2#$HOME/}"
  (( dry )) || { mkdir -p "$(dirname "$2")"; cp --preserve=mode,timestamps "$1" "$2"; }
  copied=$((copied + 1))
}

for repo in "${REPOS[@]}"; do
  [[ -d $repo ]] || { echo "skipping $repo (not found)"; continue; }
  printf '\n\033[1;34m==>\033[0m \033[1m%s\033[0m\n' "$repo"

  root=$(dirname "$repo")
  asset_dirs=()
  for dir in "${!ASSETS[@]}"; do [[ -d $repo/$dir ]] && asset_dirs+=("$root/${dir#../}"); done

  while IFS= read -r -d '' file; do
    if [[ $file == "$repo"/* ]]; then rel=${file#"$repo"/}; else rel=../${file#"$root"/}; fi
    [[ $SKIP == *" $rel "* ]] && continue
    src=$(source_for "$rel")
    [[ -n $src ]] || continue
    if [[ ! -f $src ]]; then
      printf '  \033[33m%-8s\033[0m %s (no %s)\n' missing "$rel" "${src/#$HOME/\~}"
      missing=$((missing + 1)); continue
    fi
    cmp -s "$src" "$file" && continue
    if (( !force )) && [[ $file -nt $src ]]; then
      printf '  \033[36m%-8s\033[0m %s (repo copy is newer than %s)\n' kept "$rel" "${src/#$HOME/\~}"
      kept=$((kept + 1)); continue
    fi
    copy "$src" "$file" updated
  done < <(find "$repo" "${asset_dirs[@]}" -type f -print0 | sort -z)

  if (( add )); then
    for dir in "$repo"/config/*/; do
      dir=${dir%/}; live="$HOME/.config/${dir##*/}"
      [[ ${dir##*/} == starship ]] && live="$HOME/Documents/starship"
      [[ -d $live ]] || continue
      while IFS= read -r -d '' src; do
        dest="$dir/${src#$live/}"
        [[ -e $dest ]] || copy "$src" "$dest" new
      done < <(find "$live" -type f -not -path '*/.git/*' -print0 | sort -z)
    done
    while IFS= read -r -d '' src; do
      dest="$repo/wallpaper/${src##*/}"
      [[ -e $dest ]] || copy "$src" "$dest" new
    done < <(find "$HOME/Pictures/wallpaper" -maxdepth 1 -type f -print0 2>/dev/null | sort -z)
    for dir in "${!ASSETS[@]}"; do
      live=${ASSETS[$dir]}
      [[ -d $live ]] || continue
      while IFS= read -r -d '' src; do
        dest="$root/${dir#../}/${src#"$live"/}"
        [[ -e $dest ]] || copy "$src" "$dest" new
      done < <(find "$live" -type f -print0 | sort -z)
    done
  fi
done

echo
(( dry )) && verb="would copy" || verb="copied"
echo "$verb $copied, kept $kept newer repo files, $missing with no live copy"
(( kept && !force )) && echo "re-run with --force to overwrite the newer repo copies too"
exit 0
