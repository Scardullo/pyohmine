#!/bin/bash
# Usage: wallpp /path/to/image
# Sets wallpaper on all monitors and remembers it for the next login

if [ -z "$1" ]; then
    echo "Usage: $0 /path/to/wallpaper"
    exit 1
fi

WALLPAPER=$(realpath "$1") || exit 1
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"

# remember for autostart (restored after reboot)
mkdir -p "$STATE_DIR"
echo "$WALLPAPER" > "$STATE_DIR/DP-1"
echo "$WALLPAPER" > "$STATE_DIR/HDMI-A-1"

# kill previous wallpapers
pkill swaybg

# small delay to ensure cleanup
sleep 0.2

# apply per monitor (correct way)
swaybg -o DP-1 -i "$WALLPAPER" -m fill &
swaybg -o HDMI-A-1 -i "$WALLPAPER" -m fill &
