#!/usr/bin/env bash
# Wallpaper-only picker popup (bound to SUPER+SPACE): rofi single-column list of every
# wallpaper under ~/Pictures/wallpaper, scrolling top to bottom, icon-only (no names, no
# search bar), with a "Wallpapers" label above it (see rofi-name-popup). Selecting one just sets the wallpaper via `wallpp` -- it does not touch
# kitty/waybar/hyprland like the theme scripts do.

BIN="$HOME/.local/bin"
WALL_ROOT="$HOME/Pictures/wallpaper"
CACHE_DIR="$HOME/.cache/wallpaper-switcher/thumbs"
CURRENT_THEME_FILE="$HOME/.local/state/current-theme"
ROFI_THEME="$HOME/.config/rofi/wallpaper-switcher.rasi"
ROFI_TPL="$HOME/.config/rofi/wallpaper-switcher.rasi.tpl"
KITTY_DIR="$HOME/.config/kitty"
HYPR_CONF="$HOME/.config/hypr/hyprland.lua"
LOG="/tmp/wallpaper-switcher.log"

mkdir -p "$CACHE_DIR"

mapfile -t WALLPAPERS < <(
  find "$WALL_ROOT" -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \) \
    ! -iname 'preview.webp' \
  | sort \
  | xargs -d '\n' md5sum \
  | awk '{hash=$1; $1=""; path=substr($0,2); if (!(hash in seen)) { seen[hash]=1; print path }}'
)

# current-theme is written by every theme script, p10k and starship alike (e.g. "archlinux" or
# "archlinux_star"); strip _star so the overrides below apply to both variants.
ACTIVE_THEME=""
[ -f "$CURRENT_THEME_FILE" ] && ACTIVE_THEME=$(cat "$CURRENT_THEME_FILE")
PALETTE_THEME="${ACTIVE_THEME%_star}"

hex_to_rgba() {
  local hex="${1#\#}" alpha="$2" r g b
  r=$((16#${hex:0:2})); g=$((16#${hex:2:2})); b=$((16#${hex:4:2}))
  printf 'rgba(%d, %d, %d, %s)' "$r" "$g" "$b" "$alpha"
}

# Themes whose popup palette should come from a different kitty config than their own name.
# tokyo-night's kitty/tokyo-night file doesn't match its waybar; kitty/dracula holds the
# matching Tokyo Night colors (#1a1b26 / #c0caf5 / #7aa2f7).
declare -A KITTY_PALETTE_OVERRIDE=(
  [tokyo-night]="dracula"
)

# Themes whose popup accent should just be their foreground color.
declare -A ACCENT_IS_FG=(
  [gruvbox]=1
  [silvia]=1
  [elemental]=1
  [everforest]=1
  [brenda]=1
)

gen_rofi_theme() {
  # kitty.conf is what the active theme script copied in (p10k or starship variant), so it's
  # always the live palette.
  local kitty_conf="$KITTY_DIR/kitty.conf"
  [ -n "${KITTY_PALETTE_OVERRIDE[$PALETTE_THEME]}" ] && kitty_conf="$KITTY_DIR/${KITTY_PALETTE_OVERRIDE[$PALETTE_THEME]}"
  bg_hex="#14141c"; fg_hex="#e8e8f0"; accent_hex="#8aadf4"   # global: the label reads them too
  if [ -n "$PALETTE_THEME" ] && [ -f "$kitty_conf" ]; then
    local v
    v=$(grep -m1 -E '^background[[:space:]]' "$kitty_conf" | awk '{print $2}'); [ -n "$v" ] && bg_hex="$v"
    v=$(grep -m1 -E '^foreground[[:space:]]' "$kitty_conf" | awk '{print $2}'); [ -n "$v" ] && fg_hex="$v"
    v=$(grep -m1 -E '^color12[[:space:]]' "$kitty_conf" | awk '{print $2}')
    [ -z "$v" ] && v=$(grep -m1 -E '^color4[[:space:]]' "$kitty_conf" | awk '{print $2}')
    [ -n "$v" ] && accent_hex="$v"
  fi
  [ -n "$PALETTE_THEME" ] && [ -n "${ACCENT_IS_FG[$PALETTE_THEME]}" ] && accent_hex="$fg_hex"

  local bg_rgba bg_alt_rgba
  bg_rgba=$(hex_to_rgba "$bg_hex" 0.95)
  bg_alt_rgba=$(hex_to_rgba "$accent_hex" 0.16)

  # Match the active hyprland template's corners: rounding = 0 -> square popup,
  # otherwise use the radii written in the template as __RADIUS_<px>__.
  local rounding radius_repl='\1px'
  rounding=$(grep -m1 -oE '^[[:space:]]*rounding[[:space:]]*=[[:space:]]*[0-9]+' "$HYPR_CONF" 2>/dev/null | grep -oE '[0-9]+$')
  [ "$rounding" = "0" ] && radius_repl='0px'

  sed -E \
    -e "s|__RADIUS_([0-9]+)__|$radius_repl|g" \
    -e "s|__BG__|$bg_rgba|" \
    -e "s|__BG_ALT__|$bg_alt_rgba|" \
    -e "s|__FG__|$fg_hex|" \
    -e "s|__ACCENT__|$accent_hex|g" \
    "$ROFI_TPL" > "$ROFI_THEME"
}

thumb_for() {
  local wall="$1" key thumb
  key=$(printf '%s' "$wall" | md5sum | cut -d' ' -f1)
  thumb="$CACHE_DIR/$key.png"
  if [ ! -f "$thumb" ] || [ "$wall" -nt "$thumb" ]; then
    magick "$wall" -resize 280x157^ -gravity center -extent 280x157 "$thumb" 2>>"$LOG" || cp "$wall" "$thumb"
  fi
  printf '%s' "$thumb"
}

build_menu() {
  local wall thumb
  for wall in "${WALLPAPERS[@]}"; do
    thumb=$(thumb_for "$wall")
    printf '\0icon\x1f%s\n' "$thumb"
  done
}

gen_rofi_theme

# "Wallpapers" label above the grid and the colored panel behind it, same as the theme switchers.
# Grid size: N x (200 icon + 2*6 padding + 2*2 border) + (N-1)*12 spacing + 2*20 padding + 2*2 border,
# 4 columns wide. Keep in step with wallpaper-switcher.rasi.tpl.
# Rows: 5, or fewer when the focused monitor is too short for them plus the label (80 + 10 gap + 12
# margin above the grid), e.g. 4 on a 1080p screen.
grid_height() { echo $(( $1 * 216 + ($1 - 1) * 12 + 44 )); }
AVAIL=$(hyprctl monitors -j | python3 -c '
import json, sys
m = [m for m in json.load(sys.stdin) if m["focused"]][0]
print(m["height"] - m["reserved"][1] - m["reserved"][3])
')
ROWS_SHOWN=5
while [ "$ROWS_SHOWN" -gt 1 ] && [ $(( 102 + $(grid_height "$ROWS_SHOWN") )) -gt "${AVAIL:-9999}" ]; do
  ROWS_SHOWN=$((ROWS_SHOWN - 1))
done
export ROFI_NAME_GRID_WIDTH=900 ROFI_NAME_GRID_HEIGHT=$(grid_height "$ROWS_SHOWN")
ROWS="${XDG_RUNTIME_DIR:-/tmp}/rofi-name-popup.rows"
printf 'Wallpapers\t%s\t%s\t%s\n' "$bg_hex" "$fg_hex" "$accent_hex" > "$ROWS"
rm -f "${XDG_RUNTIME_DIR:-/tmp}/rofi-name-popup/ready"
"$BIN/rofi-name-popup" serve "$ROWS" bottom $'\uf03e' &
POPUP_PID=$!
"$BIN/rofi-name-popup" wait

CHOICE_INDEX=$(build_menu | "$BIN/rofi-slide" bottom -dmenu -i -p "" -theme "$ROFI_THEME" -show-icons -format i \
  -theme-str "window { location: north; anchor: north; y-offset: $("$BIN/rofi-name-popup" top)px; } listview { lines: $ROWS_SHOWN; }")
rofi_status=$?
kill "$POPUP_PID" 2>/dev/null
[ "$rofi_status" -eq 0 ] || exit 0

[ -z "${CHOICE_INDEX:-}" ] && exit 0

chosen="${WALLPAPERS[$CHOICE_INDEX]}"

if [ -n "$chosen" ]; then
  setsid wallpp "$chosen" >>"$LOG" 2>&1 &
  disown
fi
