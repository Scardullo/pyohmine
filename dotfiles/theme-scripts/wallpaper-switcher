#!/usr/bin/env bash
# Wallpaper-only picker popup (bound to SUPER+SPACE): rofi single-column list of every
# wallpaper under ~/Pictures/wallpaper, scrolling top to bottom, icon-only (no names, no
# search bar). Selecting one just sets the wallpaper via `wallpp` -- it does not touch
# kitty/waybar/hyprland like the theme scripts do.

WALL_ROOT="$HOME/Pictures/wallpaper"
CACHE_DIR="$HOME/.cache/wallpaper-switcher/thumbs"
CURRENT_THEME_FILE="$HOME/.local/state/current-theme"
ROFI_THEME="$HOME/.config/rofi/wallpaper-switcher.rasi"
ROFI_TPL="$HOME/.config/rofi/wallpaper-switcher.rasi.tpl"
KITTY_DIR="$HOME/.config/kitty"
HYPR_CONF="$HOME/.config/hypr/hyprland.lua"
LOG="/tmp/wallpaper-switcher.log"

mkdir -p "$CACHE_DIR"

mapfile -t WALLPAPERS < <(
  find "$WALL_ROOT" -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \) \
    ! -iname 'preview.webp' \
  | sort \
  | xargs -d '\n' md5sum \
  | awk '{hash=$1; $1=""; path=substr($0,2); if (!(hash in seen)) { seen[hash]=1; print path }}'
)

CURRENT_SCRIPT=""
[ -f "$CURRENT_THEME_FILE" ] && CURRENT_SCRIPT=$(cat "$CURRENT_THEME_FILE")

hex_to_rgba() {
  local hex="${1#\#}" alpha="$2" r g b
  r=$((16#${hex:0:2})); g=$((16#${hex:2:2})); b=$((16#${hex:4:2}))
  printf 'rgba(%d, %d, %d, %s)' "$r" "$g" "$b" "$alpha"
}

# Themes whose popup palette should come from a different kitty config than their own name.
# tokyo-night's kitty/tokyo-night file doesn't match its waybar; kitty/dracula holds the
# matching Tokyo Night colors (#1a1b26 / #c0caf5 / #7aa2f7).
declare -A KITTY_PALETTE_OVERRIDE=(
  [tokyo-night]="dracula"
)

# Themes whose popup accent should just be their foreground color.
declare -A ACCENT_IS_FG=(
  [gruvbox]=1
  [silvia]=1
  [elemental]=1
)

gen_rofi_theme() {
  local kitty_name="$CURRENT_SCRIPT"
  [ -n "$kitty_name" ] && kitty_name="${KITTY_PALETTE_OVERRIDE[$kitty_name]:-$kitty_name}"
  local kitty_conf="$KITTY_DIR/$kitty_name"
  local bg_hex="#14141c" fg_hex="#e8e8f0" accent_hex="#8aadf4"
  if [ -n "$CURRENT_SCRIPT" ] && [ -f "$kitty_conf" ]; then
    local v
    v=$(grep -m1 -E '^background[[:space:]]' "$kitty_conf" | awk '{print $2}'); [ -n "$v" ] && bg_hex="$v"
    v=$(grep -m1 -E '^foreground[[:space:]]' "$kitty_conf" | awk '{print $2}'); [ -n "$v" ] && fg_hex="$v"
    v=$(grep -m1 -E '^color12[[:space:]]' "$kitty_conf" | awk '{print $2}')
    [ -z "$v" ] && v=$(grep -m1 -E '^color4[[:space:]]' "$kitty_conf" | awk '{print $2}')
    [ -n "$v" ] && accent_hex="$v"
  fi
  [ -n "$CURRENT_SCRIPT" ] && [ -n "${ACCENT_IS_FG[$CURRENT_SCRIPT]}" ] && accent_hex="$fg_hex"

  local bg_rgba bg_alt_rgba
  bg_rgba=$(hex_to_rgba "$bg_hex" 0.95)
  bg_alt_rgba=$(hex_to_rgba "$accent_hex" 0.16)

  # Match the active hyprland template's corners: rounding = 0 -> square popup,
  # otherwise use the radii written in the template as __RADIUS_<px>__.
  local rounding radius_repl='\1px'
  rounding=$(grep -m1 -oE '^[[:space:]]*rounding[[:space:]]*=[[:space:]]*[0-9]+' "$HYPR_CONF" 2>/dev/null | grep -oE '[0-9]+$')
  [ "$rounding" = "0" ] && radius_repl='0px'

  sed -E \
    -e "s|__RADIUS_([0-9]+)__|$radius_repl|g" \
    -e "s|__BG__|$bg_rgba|" \
    -e "s|__BG_ALT__|$bg_alt_rgba|" \
    -e "s|__FG__|$fg_hex|" \
    -e "s|__ACCENT__|$accent_hex|g" \
    "$ROFI_TPL" > "$ROFI_THEME"
}

thumb_for() {
  local wall="$1" key thumb
  key=$(printf '%s' "$wall" | md5sum | cut -d' ' -f1)
  thumb="$CACHE_DIR/$key.png"
  if [ ! -f "$thumb" ] || [ "$wall" -nt "$thumb" ]; then
    magick "$wall" -resize 280x157^ -gravity center -extent 280x157 "$thumb" 2>>"$LOG" || cp "$wall" "$thumb"
  fi
  printf '%s' "$thumb"
}

build_menu() {
  local wall thumb
  for wall in "${WALLPAPERS[@]}"; do
    thumb=$(thumb_for "$wall")
    printf '\0icon\x1f%s\n' "$thumb"
  done
}

gen_rofi_theme

CHOICE_INDEX=$(build_menu | rofi -dmenu -i -p "" -theme "$ROFI_THEME" -show-icons -format i) || exit 0

[ -z "${CHOICE_INDEX:-}" ] && exit 0

chosen="${WALLPAPERS[$CHOICE_INDEX]}"

if [ -n "$chosen" ]; then
  setsid wallpp "$chosen" >>"$LOG" 2>&1 &
  disown
fi
