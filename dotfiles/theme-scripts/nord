#!/usr/bin/env bash
# Switch to the nord theme: wallpaper, kitty, hyprland, waybar.
set -e
mkdir -p "$HOME/.local/state"
echo "$(basename "$0")" > "$HOME/.local/state/current-theme"

wallpp "/home/anthony/Pictures/wallpaper/darker-space.webp"

cp ~/.config/kitty/nord ~/.config/kitty/kitty.conf
cp ~/Documents/fastfetch-configs/arch3 ~/.config/fastfetch/config.jsonc
cp ~/pyohmine/dotfiles/zshrc/p10k ~/.zshrc
cp ~/.config/hypr/nord.lua ~/.config/hypr/hyprland.lua
hyprctl reload >/dev/null 2>&1 || true

cp ~/.config/waybar/themes/nord_style.css ~/.config/waybar/style.css
pkill waybar || true; sleep 0.3; waybar >/dev/null 2>&1 &
disown
