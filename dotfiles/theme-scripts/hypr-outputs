#!/usr/bin/env bash
# Usage: hypr-outputs [main|second]
# Prints this PC's Hyprland outputs, one per line: the main monitor (most pixels) first, then
# the rest from left to right. That's the same order install.sh uses when it writes the monitor
# and workspace rules into ~/.config/hypr (main: workspaces 1, 3-10; second: workspace 2).
#   main    print only the main monitor
#   second  print only the second monitor (nothing if there's just one)
# Prints nothing and exits 1 if Hyprland isn't reachable.

case "${1:-}" in
  ""|main|second) ;;
  *) echo "Usage: $0 [main|second]" >&2; exit 2 ;;
esac

hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
try:
    mons = [m for m in json.load(sys.stdin) if not m.get("disabled")]
except ValueError:
    sys.exit(1)
if not mons:
    sys.exit(1)
by_area = sorted(mons, key=lambda m: (-m["width"] * m["height"], m["x"], m["y"]))
names = [by_area[0]["name"]] + [m["name"] for m in sorted(by_area[1:], key=lambda m: (m["x"], m["y"]))]
pick = sys.argv[1]
if pick == "main":
    names = names[:1]
elif pick == "second":
    names = names[1:2]
print("\n".join(names))
' "${1:-}"
