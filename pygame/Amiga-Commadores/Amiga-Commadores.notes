# This line just creates a short nickname for pygame.math.Vector2,
so instead of typing:
pos = pygame.math.Vector2(100, 200)
you can simply write:
pos = vec(100, 200)

# Example use:

import pygame
vec = pygame.math.Vector2

# Player position and velocity
pos = vec(100, 300)
vel = vec(2, 0)
gravity = vec(0, 0.5)

# Update position
vel += gravity
pos += vel

print(pos)  # outputs something like <Vector2(102, 300.5)>

